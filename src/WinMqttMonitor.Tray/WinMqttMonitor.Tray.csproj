<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinMqttMonitorTray</AssemblyName>
    <RootNamespace>WinMqttMonitor.Tray</RootNamespace>
    <Version>0.1.0</Version>
    <Product>custom-windows-mqtt-monitor</Product>
    <Description>A WinMqttMonitor tálcás segédje a felhasználó sessionjében</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
